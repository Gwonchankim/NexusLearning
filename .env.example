# ---------------------------------------------------------------------------
# EduHelp_AI — environment template (PR1)
#
# Copy this file to `.env.local` (which is git-ignored) and fill in the values.
#
#   cp .env.example .env.local           # macOS / Linux
#   Copy-Item .env.example .env.local    # Windows PowerShell
#
# Where the values come from:
#   Start the local Supabase stack, then run `supabase status`.
#   - "API URL"          -> NEXT_PUBLIC_SUPABASE_URL
#   - "anon key"         -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - "service_role key" -> SUPABASE_SERVICE_ROLE_KEY
#   (These same values are also printed by `supabase start`.)
# ---------------------------------------------------------------------------

# Public Supabase URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key (safe to expose to the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Service role key. SERVER ONLY — never expose to the client.
# Not used by the app in PR1; reserved for admin/seed tooling in later PRs.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
